# PayShield AI uses PayPal Sandbox only.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret

# Optional local paths.
PAYSHIELD_DB_PATH=payshield_payments.sqlite3
PAYSHIELD_AUDIT_LOG=data/audit_log.jsonl
PAYSHIELD_FRONTEND_URL=http://localhost:5173
PAYSHIELD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Server-to-server key for POST /integrations/purchases.
PAYSHIELD_INTEGRATION_API_KEY=replace-with-a-long-random-integration-key
