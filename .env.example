# PayShield AI uses PayPal Sandbox only.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-client-secret

# Separate identity-provider credentials. Payment API credentials are not login credentials.
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
PAYPAL_IDENTITY_CLIENT_ID=replace-with-paypal-login-app-client-id
PAYPAL_IDENTITY_CLIENT_SECRET=replace-with-paypal-login-app-client-secret
PAYPAL_IDENTITY_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_IDENTITY_REDIRECT_URI=http://localhost:8000/auth/paypal/callback

# Optional local paths.
PAYSHIELD_DB_PATH=payshield_payments.sqlite3
PAYSHIELD_AUDIT_LOG=data/audit_log.jsonl
PAYSHIELD_FRONTEND_URL=http://localhost:5173
PAYSHIELD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Server-to-server key for POST /integrations/purchases.
PAYSHIELD_INTEGRATION_API_KEY=replace-with-a-long-random-integration-key

# Ollama assistant provider (advisory only; never sets PayShield decisions).
# Leave OLLAMA_MODEL empty to disable the assistant; the backend still starts.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
# Defaults to https://ollama.com when an API key is set, otherwise http://localhost:11434.
OLLAMA_BASE_URL=

# Primary structured product provider (Channel3). Set the key to enable it.
# Requested via POST https://api.trychannel3.com/v1/search with the x-api-key header.
CHANNEL3_API_KEY=

# General web-search provider. Used ONLY as an explicit fallback: it stays off
# unless PAYSHIELD_LIVE_SEARCH_FALLBACK is enabled, and every fallback result is
# labelled with the provider that produced it.
ENDLESS_SEARCH_KEY=
PAYSHIELD_LIVE_SEARCH_FALLBACK=

# Optional password-reset email delivery. Without SMTP, reset requests return setup_required.
PAYSHIELD_SMTP_HOST=
PAYSHIELD_SMTP_PORT=587
PAYSHIELD_SMTP_USER=
PAYSHIELD_SMTP_PASSWORD=
PAYSHIELD_SMTP_FROM=

# Live product rating provider (Trustpilot Product Reviews API).
# Public endpoint: GET https://api.trustpilot.com/v1/product-reviews/business-units/{businessUnitId}
# Requires both a public API key and the merchant's business unit ID.
# Leave unset to honestly report "no live rating provider configured."
TRUSTPILOT_API_KEY=
TRUSTPILOT_BUSINESS_UNIT_ID=
# Rating cache TTL in seconds (default 3600 = 1 hour). Stale entries are re-fetched.
PAYSHIELD_RATING_TTL_SECONDS=3600
